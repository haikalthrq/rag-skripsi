# syntax=docker/dockerfile:1

# Vast recommends versioned PyTorch/CUDA images for reusable templates.
ARG VASTAI_PYTORCH_IMAGE=vastai/pytorch:2.6.0-cuda-12.6.3-py312
FROM ${VASTAI_PYTORCH_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1 \
    RAG_PROJECT_ROOT=/workspace/rag-skripsi \
    PATH=/venv/main/bin:${PATH}

WORKDIR /workspace/rag-skripsi

# System packages are needed by PDF/OCR support. llama-cpp-python is omitted:
# the Vast workflow uses the HuggingFace models on the RTX 3090 instead.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libglib2.0-0 \
        libmagic1 \
        libsm6 \
        libxext6 \
        libxrender1 \
        poppler-utils \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.vast.txt /tmp/requirements.vast.txt

# Keep the large CUDA/PyTorch stack from being reinstalled over the Vast base.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --disable-pip-version-check \
        -r /tmp/requirements.vast.txt

# Models, ChromaDB, and precomputed embeddings are intentionally excluded from
# the image. They are downloaded into the direct project directories at runtime.
COPY . .
COPY docker/vast/bootstrap.sh /usr/local/bin/rag-vast-bootstrap
RUN chmod +x /usr/local/bin/rag-vast-bootstrap

# Vast SSH templates run their own startup process. Use the on-start command
# to invoke rag-vast-bootstrap; do not replace the base image ENTRYPOINT here.
CMD ["bash"]
